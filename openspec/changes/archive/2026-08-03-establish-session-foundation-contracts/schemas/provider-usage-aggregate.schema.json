{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mossx.dev/schemas/provider-usage-aggregate.schema.json",
  "title": "ProviderUsageAggregateRecorded",
  "description": "Provider Usage Ledger entry (schemaVersion 1). Ownership is provider + billing window, NOT any conversation session; it MUST NOT carry logicalSessionId or per-session sequence. Compatibility policy matches shared-canonical-entry: unknown fields preserved, unknown enums/versions fail closed.",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "usageRecordId",
    "reportSubjectId",
    "revision",
    "providerProfileId",
    "window",
    "usage",
    "breakdown",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": { "const": "provider.usageAggregateRecorded" },
    "usageRecordId": { "$ref": "#/definitions/nonEmptyString" },
    "reportSubjectId": { "$ref": "#/definitions/nonEmptyString" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedesUsageRecordId": { "$ref": "#/definitions/nonEmptyString" },
    "providerProfileId": { "$ref": "#/definitions/nonEmptyString" },
    "engine": {
      "type": "string",
      "enum": ["claude", "codex", "gemini", "kimi", "opencode"]
    },
    "window": {
      "type": "object",
      "required": ["startedAt", "endedAt"],
      "properties": {
        "startedAt": { "type": "integer", "minimum": 0 },
        "endedAt": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "coveredAttemptIds": {
      "type": "array",
      "items": { "$ref": "#/definitions/nonEmptyString" }
    },
    "usage": { "$ref": "#/definitions/usageShape" },
    "breakdown": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "attempts"],
          "properties": {
            "kind": { "const": "provider-authoritative" },
            "attempts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["attemptId", "usage"],
                "properties": {
                  "attemptId": { "$ref": "#/definitions/nonEmptyString" },
                  "usage": { "$ref": "#/definitions/usageShape" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "aggregate-only" }
          },
          "additionalProperties": true
        }
      ]
    },
    "observedAt": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true,
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "usageShape": {
      "type": "object",
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "providerReportedCost": {
          "type": "object",
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "$ref": "#/definitions/nonEmptyString" },
            "currency": { "$ref": "#/definitions/nonEmptyString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
