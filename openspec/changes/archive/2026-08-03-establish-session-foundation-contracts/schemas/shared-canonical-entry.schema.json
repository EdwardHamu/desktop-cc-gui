{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mossx.dev/schemas/shared-canonical-entry.schema.json",
  "title": "SharedCanonicalEntry",
  "description": "mossx Shared Session Canonical Event Log envelope (schemaVersion 2). Compatibility policy: unknown fields are allowed and MUST be preserved on round-trip; unknown enum values, unsupported schemaVersion, and unknown checksum algorithms MUST fail closed. See README.md.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/entryTurnRequested" },
    { "$ref": "#/definitions/entryDeliveryPrepared" },
    { "$ref": "#/definitions/entryDeliveryAccepted" },
    { "$ref": "#/definitions/entryTurnAccepted" },
    { "$ref": "#/definitions/entryTurnCommitted" },
    { "$ref": "#/definitions/entryUsageRecorded" },
    { "$ref": "#/definitions/entryControlFact" }
  ],
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256Checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "epochMs": { "type": "integer", "minimum": 0 },
    "engineType": {
      "type": "string",
      "enum": ["claude", "codex", "gemini", "kimi", "opencode"]
    },
    "reasoningSelection": {
      "type": "object",
      "required": ["effort"],
      "properties": {
        "effort": { "$ref": "#/definitions/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "executionTarget": {
      "type": "object",
      "required": ["engine"],
      "properties": {
        "engine": { "$ref": "#/definitions/engineType" },
        "providerProfileId": { "$ref": "#/definitions/nonEmptyString" },
        "modelCatalogEntryId": { "$ref": "#/definitions/nonEmptyString" },
        "model": { "$ref": "#/definitions/nonEmptyString" },
        "reasoning": { "$ref": "#/definitions/reasoningSelection" }
      },
      "additionalProperties": true
    },
    "turnExecutionSnapshot": {
      "allOf": [
        { "$ref": "#/definitions/executionTarget" },
        {
          "type": "object",
          "properties": {
            "providerProfileNameSnapshot": { "$ref": "#/definitions/nonEmptyString" },
            "providerProfileSource": { "type": "string", "enum": ["local", "managed"] },
            "runtimeCapabilityFingerprint": { "$ref": "#/definitions/nonEmptyString" }
          }
        }
      ]
    },
    "artifactRef": {
      "type": "object",
      "required": ["artifactId", "mediaType", "sha256", "locator"],
      "properties": {
        "artifactId": { "$ref": "#/definitions/nonEmptyString" },
        "mediaType": { "$ref": "#/definitions/nonEmptyString" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "locator": { "$ref": "#/definitions/nonEmptyString" },
        "redaction": {
          "type": "object",
          "required": ["policy"],
          "properties": {
            "policy": { "$ref": "#/definitions/nonEmptyString" },
            "appliedAt": { "$ref": "#/definitions/epochMs" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "canonicalUserInput": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "imageRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifactRef" }
        },
        "attachmentRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifactRef" }
        }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["imageRefs"] },
        { "required": ["attachmentRefs"] }
      ],
      "additionalProperties": true
    },
    "assistantBlock": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["text", "reasoning", "redacted-reasoning", "artifact-ref"]
        },
        "text": { "type": "string" },
        "mediaType": { "$ref": "#/definitions/nonEmptyString" },
        "artifactRef": { "$ref": "#/definitions/artifactRef" }
      },
      "additionalProperties": true
    },
    "atomicToolExchange": {
      "type": "object",
      "required": ["toolCallId", "toolName", "call", "result"],
      "properties": {
        "toolCallId": { "$ref": "#/definitions/nonEmptyString" },
        "toolName": { "$ref": "#/definitions/nonEmptyString" },
        "call": {
          "type": "object",
          "properties": {
            "argumentsSummary": { "type": "string" },
            "argumentsArtifactRef": { "$ref": "#/definitions/artifactRef" }
          },
          "additionalProperties": true
        },
        "result": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "enum": ["completed", "error", "incomplete"] },
            "outputSummary": { "type": "string" },
            "outputArtifactRef": { "$ref": "#/definitions/artifactRef" },
            "errorMessage": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "canonicalOmission": {
      "type": "object",
      "required": ["category", "reason", "disposition"],
      "properties": {
        "category": { "$ref": "#/definitions/nonEmptyString" },
        "reason": { "type": "string" },
        "retrievableRef": { "$ref": "#/definitions/nonEmptyString" },
        "disposition": {
          "type": "string",
          "enum": ["retrievable-on-demand", "not-retrievable"]
        }
      },
      "additionalProperties": true
    },
    "providerPrivateRef": {
      "type": "object",
      "required": ["refId", "engine", "kind"],
      "properties": {
        "refId": { "$ref": "#/definitions/nonEmptyString" },
        "engine": { "$ref": "#/definitions/engineType" },
        "kind": {
          "type": "string",
          "enum": ["reasoning-signature", "encrypted-thinking", "provider-raw"]
        },
        "providerProfileId": { "$ref": "#/definitions/nonEmptyString" },
        "model": { "$ref": "#/definitions/nonEmptyString" },
        "artifactRef": { "$ref": "#/definitions/artifactRef" },
        "opaqueRef": { "$ref": "#/definitions/nonEmptyString" }
      },
      "additionalProperties": true
    },
    "usageShape": {
      "type": "object",
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "cachedInputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "providerReportedCost": {
          "type": "object",
          "required": ["amount", "currency"],
          "properties": {
            "amount": { "$ref": "#/definitions/nonEmptyString" },
            "currency": { "$ref": "#/definitions/nonEmptyString" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "envelopeBase": {
      "type": "object",
      "required": [
        "schemaVersion",
        "entryId",
        "logicalSessionId",
        "sequence",
        "occurredAt",
        "factType",
        "fact",
        "payloadChecksum",
        "fidelity"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "entryId": { "$ref": "#/definitions/nonEmptyString" },
        "logicalSessionId": { "$ref": "#/definitions/nonEmptyString" },
        "sequence": { "type": "integer", "minimum": 0 },
        "occurredAt": { "$ref": "#/definitions/epochMs" },
        "factType": { "type": "string" },
        "fact": { "type": "object" },
        "payloadChecksum": { "$ref": "#/definitions/sha256Checksum" },
        "provenance": {
          "type": "object",
          "properties": {
            "engine": { "$ref": "#/definitions/engineType" },
            "providerProfileId": { "$ref": "#/definitions/nonEmptyString" },
            "bindingKey": { "$ref": "#/definitions/nonEmptyString" },
            "nativeSessionId": { "$ref": "#/definitions/nonEmptyString" },
            "runId": { "$ref": "#/definitions/nonEmptyString" },
            "turnId": { "$ref": "#/definitions/nonEmptyString" }
          },
          "additionalProperties": true
        },
        "fidelity": { "type": "string", "enum": ["canonical", "presentation-only"] }
      },
      "additionalProperties": true
    },
    "factTurnRequested": {
      "type": "object",
      "required": ["type", "logicalTurnId", "attemptId", "input", "target", "requestedAt"],
      "properties": {
        "type": { "const": "conversation.turnRequested" },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "retryOfAttemptId": { "$ref": "#/definitions/nonEmptyString" },
        "input": { "$ref": "#/definitions/canonicalUserInput" },
        "target": { "$ref": "#/definitions/turnExecutionSnapshot" },
        "requestedAt": { "$ref": "#/definitions/epochMs" }
      },
      "additionalProperties": true
    },
    "factDeliveryPrepared": {
      "type": "object",
      "required": [
        "type",
        "logicalTurnId",
        "attemptId",
        "bindingKey",
        "packageId",
        "sourceChecksum",
        "throughSequenceInclusive",
        "mode",
        "operation"
      ],
      "properties": {
        "type": { "const": "context.deliveryPrepared" },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "bindingKey": { "$ref": "#/definitions/nonEmptyString" },
        "packageId": { "$ref": "#/definitions/nonEmptyString" },
        "sourceChecksum": { "$ref": "#/definitions/sha256Checksum" },
        "fromSequenceExclusive": { "type": "integer", "minimum": 0 },
        "throughSequenceInclusive": { "type": "integer", "minimum": 0 },
        "mode": {
          "type": "string",
          "enum": [
            "native-delta",
            "native-history-import",
            "native-history-clone",
            "portable-transcript",
            "checkpoint"
          ]
        },
        "operation": { "type": "string", "enum": ["context-import", "prompt-prefix"] }
      },
      "additionalProperties": true
    },
    "factDeliveryAccepted": {
      "type": "object",
      "required": ["type", "logicalTurnId", "attemptId", "bindingKey", "packageId", "acceptedAt"],
      "properties": {
        "type": { "const": "context.deliveryAccepted" },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "bindingKey": { "$ref": "#/definitions/nonEmptyString" },
        "packageId": { "$ref": "#/definitions/nonEmptyString" },
        "nativeRequestId": { "$ref": "#/definitions/nonEmptyString" },
        "acceptedAt": { "$ref": "#/definitions/epochMs" }
      },
      "additionalProperties": true
    },
    "factTurnAccepted": {
      "type": "object",
      "required": [
        "type",
        "logicalTurnId",
        "attemptId",
        "clientTurnId",
        "bindingKey",
        "nativeSessionId",
        "acceptedAt"
      ],
      "properties": {
        "type": { "const": "conversation.turnAccepted" },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "clientTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "bindingKey": { "$ref": "#/definitions/nonEmptyString" },
        "nativeSessionId": { "$ref": "#/definitions/nonEmptyString" },
        "nativeTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "acceptedAt": { "$ref": "#/definitions/epochMs" }
      },
      "additionalProperties": true
    },
    "factTurnCommitted": {
      "type": "object",
      "required": [
        "type",
        "logicalTurnId",
        "attemptId",
        "inputEntryId",
        "assistant",
        "atomicToolExchanges",
        "artifactRefs",
        "target",
        "providerPrivateRefs",
        "omissions",
        "outcome",
        "committedAt"
      ],
      "properties": {
        "type": { "const": "conversation.turnCommitted" },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "inputEntryId": { "$ref": "#/definitions/nonEmptyString" },
        "assistant": {
          "type": "array",
          "items": { "$ref": "#/definitions/assistantBlock" }
        },
        "atomicToolExchanges": {
          "type": "array",
          "items": { "$ref": "#/definitions/atomicToolExchange" }
        },
        "artifactRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/artifactRef" }
        },
        "target": { "$ref": "#/definitions/turnExecutionSnapshot" },
        "providerPrivateRefs": {
          "type": "array",
          "items": { "$ref": "#/definitions/providerPrivateRef" }
        },
        "omissions": {
          "type": "array",
          "items": { "$ref": "#/definitions/canonicalOmission" }
        },
        "outcome": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["completed", "failed", "cancelled", "replaced"]
            },
            "errorCode": { "$ref": "#/definitions/nonEmptyString" },
            "errorMessage": { "type": "string" },
            "stopReason": { "$ref": "#/definitions/nonEmptyString" }
          },
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": { "required": ["status", "errorCode"] },
          "additionalProperties": true
        },
        "committedAt": { "$ref": "#/definitions/epochMs" }
      },
      "additionalProperties": true
    },
    "factUsageRecorded": {
      "type": "object",
      "required": [
        "type",
        "usageRecordId",
        "reportSubjectId",
        "revision",
        "logicalTurnId",
        "attemptId",
        "bindingKey",
        "nativeSessionId",
        "target",
        "usage",
        "source",
        "verification",
        "observedAt"
      ],
      "properties": {
        "type": { "const": "conversation.usageRecorded" },
        "usageRecordId": { "$ref": "#/definitions/nonEmptyString" },
        "reportSubjectId": { "$ref": "#/definitions/nonEmptyString" },
        "revision": { "type": "integer", "minimum": 1 },
        "supersedesUsageRecordId": { "$ref": "#/definitions/nonEmptyString" },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "bindingKey": { "$ref": "#/definitions/nonEmptyString" },
        "nativeSessionId": { "$ref": "#/definitions/nonEmptyString" },
        "nativeTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "target": { "$ref": "#/definitions/turnExecutionSnapshot" },
        "usage": { "$ref": "#/definitions/usageShape" },
        "source": { "type": "string", "enum": ["runtime-final", "provider-report"] },
        "verification": { "type": "string", "enum": ["verified", "unverified"] },
        "observedAt": { "$ref": "#/definitions/epochMs" }
      },
      "additionalProperties": true
    },
    "factControlFact": {
      "type": "object",
      "required": ["type", "controlKind"],
      "properties": {
        "type": { "const": "conversation.controlFact" },
        "controlKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "logicalTurnId": { "$ref": "#/definitions/nonEmptyString" },
        "attemptId": { "$ref": "#/definitions/nonEmptyString" },
        "bindingKey": { "$ref": "#/definitions/nonEmptyString" },
        "reason": { "type": "string" },
        "details": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "entryTurnRequested": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "conversation.turnRequested" },
            "fact": { "$ref": "#/definitions/factTurnRequested" }
          }
        }
      ]
    },
    "entryDeliveryPrepared": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "context.deliveryPrepared" },
            "fact": { "$ref": "#/definitions/factDeliveryPrepared" }
          }
        }
      ]
    },
    "entryDeliveryAccepted": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "context.deliveryAccepted" },
            "fact": { "$ref": "#/definitions/factDeliveryAccepted" }
          }
        }
      ]
    },
    "entryTurnAccepted": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "conversation.turnAccepted" },
            "fact": { "$ref": "#/definitions/factTurnAccepted" }
          }
        }
      ]
    },
    "entryTurnCommitted": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "conversation.turnCommitted" },
            "fact": { "$ref": "#/definitions/factTurnCommitted" }
          }
        }
      ]
    },
    "entryUsageRecorded": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "conversation.usageRecorded" },
            "fact": { "$ref": "#/definitions/factUsageRecorded" }
          }
        }
      ]
    },
    "entryControlFact": {
      "allOf": [
        { "$ref": "#/definitions/envelopeBase" },
        {
          "type": "object",
          "properties": {
            "factType": { "const": "conversation.controlFact" },
            "fact": { "$ref": "#/definitions/factControlFact" }
          }
        }
      ]
    }
  }
}
